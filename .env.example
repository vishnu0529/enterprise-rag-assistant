# LLM
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store (Qdrant)
# Local/embedded mode (default, no server needed): leave QDRANT_URL empty.
# Production mode (e.g. via docker-compose): set QDRANT_URL=http://qdrant:6333
QDRANT_URL=
QDRANT_COLLECTION=documents
QDRANT_LOCAL_PATH=./qdrant_data

# Session storage
# Local/dev default: sqlite. Production (docker-compose): postgresql://rag:rag@postgres:5432/rag
DATABASE_URL=sqlite:///./sessions.db

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=4

LOG_LEVEL=INFO
