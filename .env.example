# LLM
LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Minimum seconds between LLM calls, process-wide. 0 disables it.
# Needed on the free Gemini tier, which caps requests per minute:
#   gemini-2.5-flash       10 rpm  ->  LLM_MIN_INTERVAL_SECONDS=7
#   gemini-2.5-flash-lite  15 rpm  ->  LLM_MIN_INTERVAL_SECONDS=5
# Leave at 0 for paid tiers and for interactive use.
LLM_MIN_INTERVAL_SECONDS=0

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store (Qdrant)
# Local/embedded mode (default, no server needed): leave QDRANT_URL empty.
# Production mode (e.g. via docker-compose): set QDRANT_URL=http://qdrant:6333
QDRANT_URL=
QDRANT_COLLECTION=documents
QDRANT_LOCAL_PATH=./qdrant_data

# Session storage
# Local/dev default: sqlite. Production (docker-compose): postgresql://rag:rag@postgres:5432/rag
DATABASE_URL=sqlite:///./sessions.db

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=4

LOG_LEVEL=INFO

# API access
# Shared-secret gate for /documents, /chat, /evaluate (not /health).
# Leave empty for local dev. The gate is a no-op when unset. Set this to a
# real random value on any publicly-reachable deployment (see
# docs/DEPLOYMENT.md), and set the same value as the Streamlit dashboard's
# API_KEY secret so it can still talk to the backend.
API_KEY=
